@="Open with Readme"
"Icon"="C:\\Users\\Yassir-Houm\\ReadmeBuilder\\icon.png"

[HKEY_CLASSES_ROOT\Directory\shell\ReadmeBuilder\command]
@="\"C:\\Users\\Yassir-Houm\\ReadmeBuilder\\rm.bat\" \"%1\""

[HKEY_CLASSES_ROOT\Directory\Background\shell\ReadmeBuilder]
@="Open with Readme"
